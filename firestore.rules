rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function isAdmin() {
      return logado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // Perfil: o dono le e edita (sem poder mudar o proprio plano); o admin ve e gerencia todos
      allow read:   if logado() && (request.auth.uid == uid || isAdmin());
      allow create: if logado() && request.auth.uid == uid && request.resource.data.role == 'free';
      allow update: if isAdmin() ||
                    (logado() && request.auth.uid == uid &&
                     request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();

      // Dados financeiros (lancamentos, parceladas, metas-fin, contas, apagar, receber,
      // investimentos, ativos, passivos, categorias, bancos-custom): so o dono
      match /{colecao}/{doc} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }
  }
}
